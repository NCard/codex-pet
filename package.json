{
  "name": "ai-pet",
  "productName": "Wiki Wiki",
  "version": "1.0.3",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Kiwi Desktop Pet",
  "repository": {
    "type": "git",
    "url": "https://github.com/NCard/codex-pet.git"
  },
  "build": {
    "appId": "com.codexpet.kiwi",
    "win": {
      "target": "nsis",
      "icon": "assets/images/kiwi.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "files": [
      "**/*",
      "!.env",
      "!data/**/*",
      "!logs/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "NCard",
        "repo": "codex-pet"
      }
    ]
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^4.0.3",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "jimp": "^0.16.13"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "electron-reloader": "^1.2.3"
  }
}
