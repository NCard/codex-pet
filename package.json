{
  "name": "ai-pet",
  "productName": "Wiki Wiki",
  "version": "1.2.2",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "test": "node --test tests/crypto_utils.test.js tests/paths.test.js tests/sanitization.test.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:ui": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Kiwi Desktop Pet",
  "repository": {
    "type": "git",
    "url": "https://github.com/NCard/codex-pet.git"
  },
  "build": {
    "appId": "com.codexpet.kiwi",
    "artifactName": "Wiki-Wiki-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "assets/images/kiwi.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "files": [
      "**/*",
      "!.env",
      "!data/**/*",
      "!logs/**/*",
      "!tests/**/*",
      "!**/*.test.js"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "NCard",
        "repo": "codex-pet"
      }
    ]
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "jimp": "^0.16.13"
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "electron-reloader": "^1.2.3",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1"
  }
}
